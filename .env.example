################################################################################
# 蝦皮智慧監控 - 環境設定
# 一鍵啟動（Windows 雙擊 start.bat）時會自動建立 .env 並詢問帳號密碼，
# 其餘項目也可以在啟動後到 Web 介面的「系統設定」修改。
################################################################################

# --- 1. Web 管理介面登入帳號密碼（留空時，啟動時會請你輸入）---
WEB_USERNAME=
WEB_PASSWORD=

# 服務連接埠（預設 8000）
SERVER_PORT=8000


# --- 2. AI 模型（需支援圖片輸入；也可在 Web 介面設定）---
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter    : https://openrouter.ai/api/v1
# OpenAI        : https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL_NAME=gemini-2.5-flash

# AI 請求用的 HTTP/S 代理（可留空），例如 http://127.0.0.1:7890
PROXY_URL=

# --- AI 用量控制（省 token）---
# 每件商品最多送幾張圖片給 AI（0 = 不送圖片，最省）；圖片會先縮小再送出
AI_MAX_IMAGES=2
AI_IMAGE_MAX_SIDE=768
# 標題完全沒包含搜尋關鍵字的商品（例如搜 5070ti 時出現的 5070），不取得詳情也不送 AI
TITLE_PREFILTER=true

# 模型不支援 JSON 輸出格式時設為 false
ENABLE_RESPONSE_FORMAT=true
ENABLE_THINKING=false
AI_DEBUG_MODE=false


# --- 推薦判斷規則 ---
# AI 給的符合度分數（0-100）低於這個值時，一律不推薦（0 = 不套用）
AI_RECOMMEND_MIN_SCORE=60
# 標題含這些詞的商品直接判為不推薦，不呼叫 AI（逗號分隔；留空 = 不排除；不設定 = 使用預設清單）
# 預設：故障,零件機,無法開機,不能開機,殺肉,拆零件,維修用,預購,預訂,訂金,僅供參考,僅供展示,佔位,占位
# EXCLUDE_TITLE_WORDS=故障,零件機,預購

# --- 3. 蝦皮爬蟲 ---
# 蝦皮站點（預設臺灣站）
SHOPEE_BASE_URL=https://shopee.tw

# 是否隱藏瀏覽器視窗。設為 false 時看得到瀏覽器，遇到驗證可以手動完成。
RUN_HEADLESS=false

# 視窗可見時遇到蝦皮驗證，最多等你手動完成幾秒（0 表示不等待、直接停止任務）
MANUAL_VERIFY_TIMEOUT_SECONDS=300

# 電腦只有 Edge、沒有 Chrome 時設為 true
LOGIN_IS_EDGE=false


# --- 4. 通知（Webhook，可留空；也可在 Web 介面設定）---
# 可用變數：{{title}} {{content}} {{price}} {{reason}} {{link}} {{image_url}}
# Discord 範例：WEBHOOK_BODY='{"content":"{{title}}\n{{content}}"}'
WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_CONTENT_TYPE=JSON
WEBHOOK_HEADERS=
WEBHOOK_QUERY_PARAMETERS=
WEBHOOK_BODY=


# --- 5. 進階（一般不需要修改）---
# 任務連續失敗幾次後暫停，以及暫停秒數
TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
TASK_LOG_RETENTION_DAYS=7

# 代理輪換
PROXY_ROTATION_ENABLED=false
PROXY_ROTATION_MODE=per_task
PROXY_POOL=
PROXY_ROTATION_RETRY_LIMIT=2
PROXY_BLACKLIST_TTL=300
