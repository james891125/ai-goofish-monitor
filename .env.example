# 臺灣蝦皮 AI 商品監控系統（等待資料來源授權）
# 複製為 .env 後自行設定。不得提交 .env、Cookie、API Key 或 Webhook。
# 登入必填：無預設帳密；密碼至少 12 字元。可使用引號包住特殊字元。
WEB_USERNAME=
WEB_PASSWORD=

# 本機啟動腳本固定只綁定 127.0.0.1。Docker 對外連接埠亦只發布至 localhost。
SERVER_PORT=8000
APP_DATABASE_FILE=data/app.sqlite3
TZ=Asia/Taipei

# AI 模式選填；未設定時使用關鍵字模式。請填入供應商核准的相容端點及模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=
ENABLE_RESPONSE_FORMAT=true

# Discord Webhook 選填；把 Webhook 視為密碼，不要放進截圖、日誌或公開 Git。
DISCORD_WEBHOOK_URL=

# 現階段只有模擬來源與合法匯入來源，無需蝦皮帳密、Cookie 或 Access Token。
# 官方來源須先確認臺灣資格、搜尋權限、欄位、限流與自動化條款，才能新增介接器。
