# 臺灣蝦皮 AI 商品監控系統（等待資料來源授權）
# 複製為 .env 後自行設定。不得提交 .env、Cookie、API Key 或 Webhook。
# 登入必填：無預設帳密；密碼至少 12 字元。可使用引號包住特殊字元。
WEB_USERNAME=
WEB_PASSWORD=

# 本機啟動腳本固定只綁定 127.0.0.1。Docker 對外連接埠亦只發布至 localhost。
SERVER_PORT=8000
APP_DATABASE_FILE=data/app.sqlite3
TZ=Asia/Taipei

# AI 模式須填入供應商核准的相容端點、模型與 API Key；缺少設定會報錯，不自動降級。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=
ENABLE_RESPONSE_FORMAT=true
# 維持 AI 分析，透過有效結果重用與輸入／輸出預算節省 token。
# 輸出上限 256–4000；推理模型若常回傳不完整 JSON，可手動調高，勿無限重試。
AI_MAX_OUTPUT_TOKENS=1200
# 商品描述只送前 256–4000 字元；完整原文仍保存在本機。
AI_PRODUCT_DESCRIPTION_CHARS=2000
# 只有任務啟用圖片、且來源明確允許分享時才傳送；每件最多 0–4 張。
AI_MAX_IMAGES=2
# 合併需求與 Prompt 的字元上限 2000–40000，超過即停止，不截斷使用者指示。
AI_MAX_PROMPT_CHARS=12000
# 空白回覆預設不重試；可設 1，最多額外嘗試一次（可能增加費用）。
AI_EMPTY_RESPONSE_RETRIES=0

# Discord Webhook 選填；把 Webhook 視為密碼，不要放進截圖、日誌或公開 Git。
DISCORD_WEBHOOK_URL=

# 現階段只有模擬來源與合法匯入來源，無需蝦皮帳密、Cookie 或 Access Token。
# 官方來源須先確認臺灣資格、搜尋權限、欄位、限流與自動化條款，才能新增介接器。
