# 全部都是選填。也可以在網頁介面的「設定」裡填，會自動寫進 .env。

# AI（只有 --ai on / compare 才會用到）
# Gemini    : https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash
# OpenRouter: https://openrouter.ai/api/v1                              google/gemini-2.5-flash
# OpenAI    : https://api.openai.com/v1                                 gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL_NAME=gemini-2.5-flash

# 傳送 CSV 的 Webhook（Discord 或其他可接收檔案上傳的 Webhook）
WEBHOOK_URL=

# 瀏覽器：預設顯示視窗，遇到蝦皮驗證時才能手動完成
RUN_HEADLESS=false
# 電腦只有 Edge、沒有 Chrome 時設為 true
LOGIN_IS_EDGE=false
# 遇到驗證時最多等你幾秒
MANUAL_VERIFY_TIMEOUT_SECONDS=300

# 蝦皮站點與代理（可留空）
SHOPEE_BASE_URL=https://shopee.tw
PROXY_URL=
